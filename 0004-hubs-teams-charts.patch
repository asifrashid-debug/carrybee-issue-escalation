From 33efb92809e79930399b027321fb0d2cabce4e05 Mon Sep 17 00:00:00 2001
From: Ahmed Asif Rashid <asif.rashid@carrybee.com>
Date: Sun, 15 Nov 2026 20:56:38 +0000
Subject: [PATCH] Hubs and Teams: demo chart order from live data

app/hubs/page.js: median first comment by hub (top 6 by volume, target 2h) and volume by hub (top 8), placed after the KPI strip. app/teams/page.js: issues raised by team and breaches by team, placed after the KPI strip. No new data code; uses fields already returned by lib/analytics.js.
---
 app/hubs/page.js  | 36 ++++++++++++++++++++++++++++++++++++
 app/teams/page.js | 31 +++++++++++++++++++++++++++++++
 2 files changed, 67 insertions(+)

diff --git a/app/hubs/page.js b/app/hubs/page.js
index c98003d..c8f370f 100644
--- a/app/hubs/page.js
+++ b/app/hubs/page.js
@@ -51,6 +51,13 @@ export default function HubPerformance() {
     </th>
   );
 
+  // Demo order: median first comment and volume by hub (real data, top hubs by volume).
+  const hubsByVol = [...data.hubs].sort((a, b) => b.total - a.total || a.hub.localeCompare(b.hub));
+  const hubsMed = hubsByVol.filter((h) => h.medianResponseHours != null).slice(0, 6);
+  const maxMed = Math.max(2, ...hubsMed.map((h) => h.medianResponseHours));
+  const hubsVol = hubsByVol.slice(0, 8);
+  const maxVol = Math.max(1, ...hubsVol.map((h) => h.total));
+
   return (
     <div className="dm">
       <PageHead kicker="Hubs" title="HUB Performance" sub={`${fmtN(data.hubCount.withIssues)} hubs with escalations, of ${fmtN(data.hubCount.active)} active · ranked by first-comment SLA · all escalations in your scope`}>
@@ -70,6 +77,35 @@ export default function HubPerformance() {
         <Kpi label="Open backlog" value={fmtN(openTotal)} sub="Open hub escalations" icon="clock" tone="b" />
       </div>
 
+      <div className="grid g2">
+        <div className="card">
+          <div className="ph"><div><h3>Median First Comment by Hub</h3><small>Top 6 hubs by volume · target 2h</small></div></div>
+          {hubsMed.length === 0 ? <div className="empty">No first comments yet</div> : (
+            <div className="lst">
+              {hubsMed.map((h) => (
+                <div key={h.hub}>
+                  <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 12.5 }}><span>{h.hub}</span><b className={h.medianResponseHours <= 2 ? 'good' : 'bad'}>{fmtH(h.medianResponseHours)}</b></div>
+                  <Bar pct={(h.medianResponseHours / maxMed) * 100} color={h.medianResponseHours <= 2 ? '#3DDC97' : '#FF5D73'} />
+                </div>
+              ))}
+            </div>
+          )}
+        </div>
+        <div className="card">
+          <div className="ph"><div><h3>Volume by Hub</h3><small>Escalations raised · top 8 hubs</small></div></div>
+          {hubsVol.length === 0 ? <div className="empty">No hub escalations yet</div> : (
+            <div className="lst">
+              {hubsVol.map((h) => (
+                <div key={h.hub}>
+                  <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 12.5 }}><span>{h.hub}</span><b>{fmtN(h.total)}</b></div>
+                  <Bar pct={(h.total / maxVol) * 100} color="#F8C800" />
+                </div>
+              ))}
+            </div>
+          )}
+        </div>
+      </div>
+
       <div className="grid g3">
         {ZONES.map((z) => {
           const zh = hubs.filter((h) => h.zone === z);
diff --git a/app/teams/page.js b/app/teams/page.js
index c7632b3..f863f37 100644
--- a/app/teams/page.js
+++ b/app/teams/page.js
@@ -25,6 +25,10 @@ export default function TeamPerformance() {
   const perMember = teams.filter((t) => t.issuesPerMember != null);
   const avgPerMember = perMember.length ? Math.round((perMember.reduce((a, t) => a + t.issuesPerMember, 0) / perMember.length) * 10) / 10 : null;
   const k = data.kpi;
+  // Demo order: issues raised and breaches by team (real data).
+  const teamsByIssues = [...teams].sort((a, b) => b.issues - a.issues || a.team.localeCompare(b.team));
+  const maxTeamIssues = Math.max(1, ...teams.map((t) => t.issues));
+  const maxTeamBreaches = Math.max(1, ...teams.map((t) => t.breaches || 0));
   const weeks = data.weeks || [];
 
   const teamCard = (t, i) => {
@@ -81,6 +85,33 @@ export default function TeamPerformance() {
         <Kpi label="Issues per member" value={avgPerMember ?? '—'} sub="Average across teams" icon="trophy" tone="p" />
       </div>
 
+      {teams.length > 0 && (
+        <div className="grid g2">
+          <div className="card">
+            <div className="ph"><div><h3>Issues Raised by Team</h3><small>All escalations raised by each team's members</small></div></div>
+            <div className="lst">
+              {teamsByIssues.map((t) => (
+                <div key={t.team}>
+                  <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 12.5 }}><span>{t.team}</span><b>{fmtN(t.issues)}</b></div>
+                  <Bar pct={(t.issues / maxTeamIssues) * 100} color="#F8C800" />
+                </div>
+              ))}
+            </div>
+          </div>
+          <div className="card">
+            <div className="ph"><div><h3>Breaches by Team</h3><small>Lower is better</small></div></div>
+            <div className="lst">
+              {teamsByIssues.map((t) => (
+                <div key={t.team}>
+                  <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 12.5 }}><span>{t.team}</span><b className={t.breaches ? 'bad' : 'good'}>{fmtN(t.breaches || 0)}</b></div>
+                  <Bar pct={((t.breaches || 0) / maxTeamBreaches) * 100} color="#FF5D73" />
+                </div>
+              ))}
+            </div>
+          </div>
+        </div>
+      )}
+
       {teams.length === 0 ? (
         <div className="card"><div className="empty"><b>No teams yet</b>Team membership comes from users_roles.</div></div>
       ) : (
-- 
2.47.3

