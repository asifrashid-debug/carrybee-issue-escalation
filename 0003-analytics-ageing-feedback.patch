Subject: [PATCH] Analytics: ageing of open cases and feedback outcomes from
 live data; demo order

lib/analytics.js: ageing buckets (0-1, 2-4, 5+ whole days since submission) for open cases; feedback outcome shares for closed cases, remainder shown as no feedback yet. tests/analyticsAgeing.test.mjs: 3 tests. app/analytics/page.js: two new cards after Zone SLA.
---
 app/analytics/page.js          | 30 ++++++++++++++++++++++
 lib/analytics.js               | 20 +++++++++++++++
 tests/analyticsAgeing.test.mjs | 46 ++++++++++++++++++++++++++++++++++
 3 files changed, 96 insertions(+)
 create mode 100644 tests/analyticsAgeing.test.mjs

diff --git a/app/analytics/page.js b/app/analytics/page.js
index 66b195e..3ec7d56 100644
--- a/app/analytics/page.js
+++ b/app/analytics/page.js
@@ -106,6 +106,36 @@ export default function Analytics() {
         </div>
       </div>
 
