From 2ab01defd1479fd852e83cbe518c9c49ff6d2869 Mon Sep 17 00:00:00 2001
From: ahmed asif rashid <asif.rashid@carrybee.com>
Date: Mon, 16 Nov 2026 07:14:23 +0000
Subject: [PATCH] npm test: use file globs (Node 24 treats a directory argument
 as a file and fails)

node --test tests/ fails on Node 22+ with Cannot find module '.../tests'.
Explicit globs pass 108/108 on Node 20 and Node 24.
---
 package.json | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/package.json b/package.json
index 62f553c..3a48911 100644
--- a/package.json
+++ b/package.json
@@ -6,7 +6,7 @@
     "dev": "next dev -p 3000",
     "build": "next build",
     "start": "next start -p 3000",
-    "test": "node --test tests/",
+    "test": "node --test tests/*.test.mjs tests/*.test.js",
     "seed": "node scripts/seed-demo.js"
   },
   "dependencies": {
-- 
2.47.3

