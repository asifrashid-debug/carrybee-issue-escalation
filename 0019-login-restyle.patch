From 0fc93b31bf6d85363e4c9a33f3204141b62778fb Mon Sep 17 00:00:00 2001
From: ahmed asif rashid <asif.rashid@carrybee.com>
Date: Mon, 16 Nov 2026 07:05:17 +0000
Subject: [PATCH] Login: restyle card to approved layout

Same sign-in, sign-up and redirect logic and labels. New card with yellow top rule,
44px touch targets for tabs, inputs and submit, dark mode support.
---
 app/design-v3.css | 25 +++++++++++++++++++++++++
 app/login/page.js | 14 +++++++-------
 2 files changed, 32 insertions(+), 7 deletions(-)

diff --git a/app/design-v3.css b/app/design-v3.css
index ecff6c6..cd687cf 100644
--- a/app/design-v3.css
+++ b/app/design-v3.css
@@ -574,3 +574,28 @@ html, body { -webkit-tap-highlight-color: transparent; }
   .dm .pipe-grid > div:nth-child(odd) { border-left: 0; }
   .dm .pipe-grid > div:nth-child(n+3) { border-top: 1px solid var(--line); }
 }
+
+/* ---------- 24. Login: approved card layout (logic and labels unchanged) ---------- */
+.login-wrap { min-height: 80vh; padding: 32px 0 48px; }
+.lg-card {
+  width: min(440px, 100%); margin: 0 auto; padding: 28px 28px 24px;
+  background: #FFFFFF; border: 1px solid var(--line); border-top: 4px solid var(--y);
+  border-radius: 16px; box-shadow: 0 2px 0 rgba(23,23,28,.04), 0 18px 36px -24px rgba(23,23,28,.28);
+}
+html[data-theme="dark"] .lg-card { background: #16171C; border-color: #2A2B33; border-top-color: var(--y); box-shadow: none; }
+.lg-logo { margin-bottom: 16px; }
+.lg-logo img { height: 36px; width: auto; }
+.lg-kicker { margin-bottom: 6px; }
+.lg-title { margin: 0 0 6px; font-size: 26px; font-weight: 700; letter-spacing: -.03em; line-height: 1.15; }
+.lg-card .meta { margin: 0 0 18px; font-size: 13px; line-height: 1.5; }
+.lg-seg { display: flex; width: 100%; margin-bottom: 16px; }
+.lg-seg button { flex: 1 1 0; min-height: 44px; font-size: 13px; }
+.lg-form { gap: 14px; }
+.lg-card .field { font-size: 12px; }
+.lg-card .inp { min-height: 44px; font-size: 15px; }
+.lg-submit { width: 100%; min-height: 46px; font-size: 15px; margin-top: 4px; }
+.lg-card .box { margin-bottom: 14px; }
+@media (max-width: 480px) {
+  .lg-card { padding: 22px 20px 20px; border-radius: 14px; }
+  .lg-title { font-size: 23px; }
+}
diff --git a/app/login/page.js b/app/login/page.js
index c26609a..9ebd38e 100644
--- a/app/login/page.js
+++ b/app/login/page.js
@@ -41,13 +41,13 @@ function LoginForm() {
 
   return (
     <div className="login-wrap">
-      <div className="glass login-card">
-        <div className="login-logo"><img src="/carrybee-logo.png" alt="CarryBee" /></div>
-        <div className="kicker">Issue Escalation Tracker</div>
-        <h1>{mode === 'signin' ? 'Sign in' : 'Create your account'}</h1>
+      <div className="lg-card">
+        <div className="lg-logo"><img src="/carrybee-logo.png" alt="CarryBee" /></div>
+        <div className="kicker lg-kicker">Issue Escalation Tracker</div>
+        <h1 className="lg-title">{mode === 'signin' ? 'Sign in' : 'Create your account'}</h1>
         <p className="meta">{mode === 'signin' ? 'Use your CarryBee email and password.' : 'Only emails on the CarryBee access list can create an account.'}</p>
 
-        <div className="seg" role="tablist" aria-label="Sign in or create account" style={{ marginBottom: 14 }}>
+        <div className="seg lg-seg" role="tablist" aria-label="Sign in or create account">
           <button type="button" role="tab" aria-selected={mode === 'signin'} className={mode === 'signin' ? 'on' : ''} onClick={() => { setMode('signin'); setErr(null); }}>Sign in</button>
           <button type="button" role="tab" aria-selected={mode === 'signup'} className={mode === 'signup' ? 'on' : ''} onClick={() => { setMode('signup'); setErr(null); }}>Create account</button>
         </div>
@@ -55,14 +55,14 @@ function LoginForm() {
         {err && <div className="box box-bad" role="alert">{err}</div>}
         {note && <div className="box box-ok" role="status">{note}</div>}
 
-        <form onSubmit={submit} className="stack">
+        <form onSubmit={submit} className="stack lg-form">
           <label className="field">Email
             <input className="inp" type="email" autoComplete="email" required value={email} onChange={(e) => setEmail(e.target.value)} placeholder="name@carrybee.com" />
           </label>
           <label className="field">Password{mode === 'signup' ? ' (at least 8 characters)' : ''}
             <input className="inp" type="password" autoComplete={mode === 'signin' ? 'current-password' : 'new-password'} required minLength={mode === 'signup' ? 8 : undefined} value={password} onChange={(e) => setPassword(e.target.value)} />
           </label>
-          <button type="submit" className="btn-primary" disabled={busy}>{busy ? 'Please wait…' : mode === 'signin' ? 'Sign in' : 'Create account and sign in'}</button>
+          <button type="submit" className="btn-primary lg-submit" disabled={busy}>{busy ? 'Please wait…' : mode === 'signin' ? 'Sign in' : 'Create account and sign in'}</button>
         </form>
         <InstallApp />
       </div>
-- 
