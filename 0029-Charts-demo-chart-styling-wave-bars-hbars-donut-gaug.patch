+.dchart .donut .dc b { font: 700 24px var(--font-sans, Inter, system-ui, sans-serif); letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
+.dchart .donut .dc span { font-size: 11px; color: var(--mut); }
+
+.dchart .gauge-track { stroke: rgba(128, 128, 128, .14); }
+
+/* Card header and spacing from the demo (scoped) */
