
# Daily 8 PM report (Gmail SMTP app password, cron auth)
GMAIL_USER=<...>
GMAIL_APP_PASSWORD=<...>
CRON_SECRET=<...>

# Server-side hub lookup for phones (no browser extension needed). All optional.
# When HIVE_API_URL is empty, the form fills the hub from the last escalation
# for the same Consignment ID, and offers manual selection when there is none.
# HIVE_API_URL: URL template with {id} replaced by the Consignment ID
HIVE_API_URL=<...>
# HIVE_API_KEY: optional, sent as "Authorization: Bearer <key>"
HIVE_API_KEY=<...>
# HIVE_HUB_JSON_PATH: dot path to the hub text in the JSON response (default: hub)
HIVE_HUB_JSON_PATH=<...>
# HIVE_LOOKUP_METHOD: GET (default) or POST
HIVE_LOOKUP_METHOD=<...>
# HIVE_TIMEOUT_MS: request timeout in ms (default 8000)
HIVE_TIMEOUT_MS=<...>

# IR Issue Escalation (documentation only, no values)
# IR_SHEET_ID: the CarryBee IR Issue Escalation spreadsheet ID
IR_SHEET_ID=<set>

# Central Sort and TNL response sheets (same 35 columns as the hub response sheet). Share each with the OAuth account.
SHEET_CENTRAL_SORT=<set>
SHEET_TNL=<set>
# DRIVE_IR_FOLDER_ID: Google Drive folder that holds the IR attachment zips.
# The OAuth refresh token needs the drive.file scope for this.
DRIVE_IR_FOLDER_ID=<set>
# IR SLA targets in hours (clock hours). Unset means "No SLA set" until the user confirms them.
IR_PICK_SLA_HOURS=<set>
IR_RESOLVE_SLA_HOURS=<set>

# IR mail lookup (KAM drawer). Gmail API, read-only, for the GMAIL_USER mailbox.
# GMAIL_OAUTH_REFRESH_TOKEN: a refresh token minted with the gmail.readonly scope, signed in as GMAIL_USER.
# It is separate from GOOGLE_OAUTH_REFRESH_TOKEN (Sheets and Drive), which stays unchanged.
GMAIL_OAUTH_REFRESH_TOKEN=<set>

# Central Sort and TNL: each response sheet's Apps Script web app (its URL is bound to one sheet).
# ROUTE_SCRIPT_SECRET must equal the ROUTE_SECRET Script property in each sheet's script.
ROUTE_SCRIPT_URL_CENTRAL_SORT=<set>
ROUTE_SCRIPT_URL_TNL=<set>
ROUTE_SCRIPT_SECRET=<set>
