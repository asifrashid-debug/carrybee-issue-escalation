From 0210b721d6eb1b84649084c9b0198bba5846a5c4 Mon Sep 17 00:00:00 2001
From: Ahmed Asif Rashid <asif.rashid@carrybee.com>
Date: Sun, 15 Nov 2026 20:59:11 +0000
Subject: [PATCH] Tracker: queue with context column (open by zone, priority
 mix, top categories)

app/page.js: queue wrapped in a two-column layout; right column shows read-only context from the existing analytics data. Hidden on phones. app/design-v3.css: section 23 (trk-layout, stacks below 1100px).
---
 app/design-v3.css | 13 ++++++++++++
 app/page.js       | 50 ++++++++++++++++++++++++++++++++++++++++++++++-
 2 files changed, 62 insertions(+), 1 deletion(-)

diff --git a/app/design-v3.css b/app/design-v3.css
index 45eb958..f721166 100644
--- a/app/design-v3.css
+++ b/app/design-v3.css
@@ -542,3 +542,16 @@ html, body { -webkit-tap-highlight-color: transparent; }
   .dm .grid.kpi-strip > .card { background: var(--glass); border: 1px solid var(--line); border-radius: 16px; padding: 14px; box-shadow: 0 1px 2px rgba(20, 20, 30, .04); }
   .dm .grid.kpi-strip > .card.hot { box-shadow: inset 0 3px 0 var(--bad), 0 1px 2px rgba(20, 20, 30, .04); }
 }
+
+
+/* ---------- 23. Tracker: queue with context column (desktop); stacks below 1100px; hidden on phone ---------- */
+.dm .trk-layout { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 16px; align-items: start; }
+.dm .trk-main { min-width: 0; }
+.dm .trk-side { position: sticky; top: calc(var(--hdr) + 16px); display: grid; gap: 12px; }
+@media (max-width: 1100px) {
+  .dm .trk-layout { grid-template-columns: minmax(0, 1fr); }
+  .dm .trk-side { position: static; grid-template-columns: repeat(3, minmax(0, 1fr)); }
+}
+@media (max-width: 720px) {
+  .dm .trk-side { grid-template-columns: minmax(0, 1fr); }
+}
diff --git a/app/page.js b/app/page.js
index 85ed079..ee12a00 100644
--- a/app/page.js
+++ b/app/page.js
@@ -3,7 +3,7 @@ import { useCallback, useEffect, useState } from 'react';
 import IssueDrawer from '../components/IssueDrawer';
 import CopyButton from '../components/CopyButton';
 import { useAnalytics } from '../components/useAnalytics';
-import { PageHead, Kpi, LiveChip, PriPill, SlaPill, StatusPill, Zc, fmtN } from '../components/demo';
+import { PageHead, Kpi, LiveChip, PriPill, SlaPill, StatusPill, Zc, Bar, fmtN } from '../components/demo';
 import { formatDhaka, hoursSince } from '../lib/time';
 
 const PAGE = 20;
@@ -286,6 +286,8 @@ export default function Tracker() {
         <Kpi label={`Resolved this week${weekLabel ? ` (${weekLabel})` : ''}`} value={fmtN(resolvedWeek)} sub="Ops status Resolved this week" icon="check" tone="g" />
       </div>
 
+      <div className="trk-layout">
+        <div className="trk-main">
       <div className="card" style={{ padding: '12px 14px', marginBottom: 12 }}>
         <div className="views" role="group" aria-label="Tracker views">
           <span className="lb">Views:</span>
@@ -457,6 +459,52 @@ export default function Tracker() {
         </div>
       )}
 
+        </div>
+
+        {stats && (
+          <aside className="trk-side only-desk" aria-label="Queue context">
+            <div className="card">
+              <div className="ph"><div><h3>Open by Zone</h3><small>Share of open queue</small></div></div>
+              <div className="lst">
+                {stats.zones.map((z) => (
+                  <div key={z.zone}>
+                    <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 12.5 }}><span>{z.zone}</span><b>{fmtN(z.open)}</b></div>
+                    <Bar pct={stats.kpi.open ? (z.open / stats.kpi.open) * 100 : 0} color={{ ISD: '#F8C800', OSD: '#3B9CFF', CTG: '#A78BFA' }[z.zone]} />
+                  </div>
+                ))}
+              </div>
+            </div>
+            <div className="card">
+              <div className="ph"><div><h3>Priority Mix</h3><small>Open issues by priority</small></div></div>
+              <div className="lst">
+                {stats.priorities.map((p) => {
+                  const openAll = stats.priorities.reduce((a, x) => a + x.open, 0);
+                  return (
+                    <div key={p.label}>
+                      <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 12.5 }}><span>{p.label}</span><b>{fmtN(p.open)}</b></div>
+                      <Bar pct={openAll ? (p.open / openAll) * 100 : 0} color={{ P1: '#FF5D73', P2: '#FFB020', P3: '#A3A1A8', P4: '#6B6B73' }[p.label]} />
+                    </div>
+                  );
+                })}
+              </div>
+            </div>
+            <div className="card">
+              <div className="ph"><div><h3>Top Categories</h3><small>All issues · top 5</small></div></div>
+              {stats.categories.length === 0 ? <div className="empty">No categories yet</div> : (
+                <div className="lst">
+                  {stats.categories.slice(0, 5).map((c) => (
+                    <div key={c.label}>
+                      <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 12.5 }}><span>{c.label}</span><b>{fmtN(c.count)}</b></div>
+                      <Bar pct={(c.count / Math.max(1, stats.categories[0].count)) * 100} color="#F8C800" />
+                    </div>
+                  ))}
+                </div>
+              )}
+            </div>
+          </aside>
+        )}
+      </div>
+
       <p className="note2">Paged on the server, 20 per page, newest first. Click a row for the issue detail. Times are Asia/Dhaka. Exports include every row in the current view.</p>
 
       <IssueDrawer issueId={openId} user={user} onClose={() => setOpenId(null)} onChanged={() => { load(); analytics.reload(); }} onOpen={setOpenId} />
-- 
