From a0826ea3084905cbdbd112ce7738b5029bed28e8 Mon Sep 17 00:00:00 2001
From: Ahmed Asif Rashid <asif.rashid@carrybee.com>
Date: Sun, 15 Nov 2026 20:57:20 +0000
Subject: [PATCH] Sync: KPI row in the shared strip style

app/sync/page.js: adds kpi-strip to the three status cards, matching the other pages. No logic change.
---
 app/sync/page.js | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/app/sync/page.js b/app/sync/page.js
index 08904fe..dcbd1d1 100644
--- a/app/sync/page.js
+++ b/app/sync/page.js
@@ -71,7 +71,7 @@ export default function SyncHealth() {
       </div>
 
       {data && (
-        <div className="grid g3">
+        <div className="grid g3 kpi-strip">
           <div className="card">
             <div className="kl">Queue depth</div>
             <div className={`kv ${data.queue_depth ? '' : ''}`} style={{ color: data.queue_depth ? 'var(--warn)' : 'var(--good)' }}>{fmtN(data.queue_depth)}</div>
-- 
2.47.3

