@@ -0,0 +1,519 @@
+:root{
+  --bee:#FFCC00;--bee-soft:#FDE68A;--ink:#08090B;
+  --mint:#00E5A0;--mint-ink:#0A7A56;--flare:#FF5470;--flare-ink:#C81E3F;
+  --azure:#37A9FF;--azure-ink:#1F6FD1;--violet:#A78BFA;--violet-ink:#6D4AD6;
+  --paper:#F6F5F1;--card:#FFFFFF;--line:#E5E3DB;--line2:#EFEDE7;--track:#EFEDE7;--grid:#EEECE6;--mut:#6B6F78;--text:#111216;
+  --font:"Inter",ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
+  --mono:"JetBrains Mono",ui-monospace,Consolas,monospace;
+}
+*{box-sizing:border-box}
+html,body{margin:0}
+body{background:#E9E7E0;color:var(--text);font:14px/1.5 var(--font);-webkit-font-smoothing:antialiased}
+.top{position:sticky;top:0;z-index:10;background:#fff;border-bottom:1px solid var(--line)}
+.top-in{max-width:1280px;margin:0 auto;padding:12px 24px;display:flex;align-items:center;gap:24px;flex-wrap:wrap}
+.brand{display:flex;align-items:center;gap:14px}
+.brand img{height:26px;display:block}
+.brand small{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--mut);font-weight:600;border-left:1px solid var(--line);padding-left:14px}
+.tabs{margin-left:auto;display:flex;gap:4px;background:#F1F0EB;padding:4px;border-radius:12px;flex-wrap:wrap}
+.tabs button{border:0;background:transparent;font:600 13px var(--font);color:var(--mut);padding:8px 12px;border-radius:9px;cursor:pointer}
+.tabs button.on{background:#fff;color:var(--text);box-shadow:0 1px 2px rgba(0,0,0,.08)}
+.tabs button:focus-visible{outline:2px solid var(--bee)}
+main{max-width:1280px;margin:0 auto;padding:28px 24px 56px}
+.view{display:none}.view.on{display:block}
+.ph{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin:6px 0 20px}
+.kicker{display:flex;align-items:center;gap:8px;font:600 11px var(--font);letter-spacing:.14em;text-transform:uppercase;color:var(--mut)}
+h1{font-size:30px;line-height:1.15;letter-spacing:-.02em;margin:8px 0 4px;font-weight:700}
+h2{font-size:15px;font-weight:600;margin:0;letter-spacing:-.005em}
+h3{font-size:13px;font-weight:600;margin:0 0 6px}
+.sub{color:var(--mut);max-width:640px;margin:0}
+.muted{color:var(--mut)}
+.small{font-size:12px}
+.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px 20px;min-width:0}
+.card-h{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px;flex-wrap:wrap}
+.card-h small{color:var(--mut);font-size:12px}
+.grid{display:grid;gap:16px}
+.g2{grid-template-columns:1fr 1fr}
+.g3{grid-template-columns:1fr 1fr 1fr}
+.stack{display:grid;gap:16px;align-content:start}
+.mt{margin-top:16px}
+.ic{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;flex:none;display:block}
+.ic.lg{width:28px;height:28px}
+.ic.xl{width:40px;height:40px}
+.pill{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 9px;border-radius:999px;font:600 11.5px var(--font);white-space:nowrap}
+.p-urg{background:#FFE4E9;color:var(--flare-ink)}
+.p-crit{background:#FFF3C2;color:#7A5B00}
+.p-reg{background:#E3FBF3;color:var(--mint-ink)}
+.p-breach{background:var(--flare);color:#fff}
+.p-ok{background:#E3FBF3;color:var(--mint-ink)}
+.p-wait{background:#EAF3FE;color:var(--azure-ink)}
+.p-res{background:#F0EEE8;color:var(--mut)}
+.mono{font-family:var(--mono);font-size:12.5px;font-weight:500;letter-spacing:0}
+.chart{width:100%;height:auto;display:block;overflow:visible}
+.chart .gl{stroke:var(--grid);stroke-width:1}
+.chart .ax{font:500 10.5px var(--font);fill:var(--mut)}
+.chart .val{font:600 11px var(--font);fill:var(--text)}
+.chart .base{stroke:var(--line);stroke-width:1}
+.chart .gv{font:700 26px var(--font);fill:var(--text)}
+.spark{width:100%;height:40px;display:block;margin-top:8px}
+.legend{display:flex;flex-wrap:wrap;gap:12px;font-size:12px;color:var(--mut)}
+.legend span{display:inline-flex;align-items:center;gap:6px}
+.legend i{display:inline-block;width:9px;height:9px;border-radius:50%}
+.hbar{display:grid;grid-template-columns:112px 1fr 40px;align-items:center;gap:12px;margin:10px 0;font-size:13px}
+.hbar span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.hbar .track{height:8px;border-radius:99px;background:var(--track);overflow:hidden}
+.hbar .fill{height:100%;border-radius:99px}
+.hbar b{text-align:right;font-variant-numeric:tabular-nums;font-weight:600}
+.stackbar{display:flex;height:14px;border-radius:99px;overflow:hidden;gap:3px}
+.stackbar i{display:block;height:100%;border-radius:99px}
+.donut{position:relative;width:max-content}
+.donut svg{display:block}
+.donut .dc{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
+.donut .dc b{font:700 24px var(--font);letter-spacing:-.02em;font-variant-numeric:tabular-nums}
+.donut .dc span{font-size:11px;color:var(--mut)}
+.kpis{display:grid;grid-template-columns:repeat(4,1fr);border:1px solid var(--line);border-radius:16px;background:var(--card);overflow:hidden}
+.kpi{padding:18px 20px;border-right:1px solid var(--line);min-width:0}
+.kpi:last-child{border-right:0}
+.kpi .lab{display:flex;align-items:center;gap:8px;color:var(--mut);font-size:12.5px;font-weight:500}
+.kpi .num{font:700 34px/1.1 var(--font);letter-spacing:-.03em;margin:10px 0 2px;font-variant-numeric:tabular-nums}
+.delta{font-size:12px;font-weight:600}
+.good{color:var(--mint-ink)}
+.bad{color:var(--flare-ink)}
+table{width:100%;border-collapse:collapse}
+th{font:600 11px var(--font);letter-spacing:.06em;text-transform:uppercase;color:var(--mut);text-align:left;padding:10px 12px;border-bottom:1px solid var(--line)}
+td{padding:12px;border-bottom:1px solid var(--line2);vertical-align:middle;font-size:13px}
+tr:last-child td{border-bottom:0}
+.btn{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 14px;border-radius:10px;border:1px solid var(--line);background:var(--card);font:600 13px var(--font);color:var(--text);cursor:default}
+.btn.primary{background:var(--ink);color:#fff;border-color:var(--ink)}
+.btn.bee{background:var(--bee);border-color:var(--bee);color:var(--ink)}
+.seg{display:inline-flex;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:3px}
+.seg span{padding:6px 10px;border-radius:8px;font:600 12.5px var(--font);color:var(--mut)}
+.seg .on{background:var(--ink);color:#fff}
+.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--mint)}
+.live{width:8px;height:8px;border-radius:50%;background:var(--mint);box-shadow:0 0 0 4px rgba(0,229,160,.18)}
+.swatch{height:64px;border-radius:12px;padding:10px;display:flex;flex-direction:column;justify-content:flex-end;font:600 12px var(--font)}
+.swatch small{font:500 11px var(--mono);opacity:.8}
+.search{display:flex;align-items:center;gap:10px;height:40px;padding:0 14px;border:1px solid var(--line);border-radius:12px;background:var(--card);color:var(--mut);min-width:280px}
+.chips{display:flex;gap:8px;flex-wrap:wrap}
+.chip{display:inline-flex;align-items:center;gap:8px;height:34px;padding:0 12px;border-radius:999px;border:1px solid var(--line);background:var(--card);font:600 12.5px var(--font);color:var(--mut)}
+.chip.on{background:var(--ink);color:#fff;border-color:var(--ink)}
+.chip b{font-variant-numeric:tabular-nums}
+.note{font-size:12px;color:var(--mut);margin-top:16px}
+
+/* Concept A · quiet ledger */
+.kpi-a .num{font-size:36px}
+
+/* Concept B · ink console (dark) */
+.dark{background:var(--ink);color:var(--text);border-radius:22px;padding:22px}
+.dk{--paper:#08090B;--card:#111317;--line:#22252C;--line2:#1A1D23;--track:#22252C;--grid:#1C1F25;--mut:#8B919B;--text:#F4F4F5;color:var(--text)}
+.dk .p-urg{background:rgba(255,84,112,.16);color:#FF8DA0}
+.dk .p-crit{background:rgba(255,204,0,.14);color:#FFD84D}
+.dk .p-reg{background:rgba(0,229,160,.14);color:#4DF5BC}
+.dk .p-wait{background:rgba(55,169,255,.16);color:#7CC3FF}
+.dk .p-res{background:rgba(255,255,255,.06);color:#A3A9B3}
+.dk .good{color:#4DF5BC}
+.dk .bad{color:#FF8DA0}
+.dk .btn{background:#16181D;border-color:#2A2E36;color:var(--text)}
+.dk .chip{background:#16181D;border-color:#2A2E36}
+.dk .chip.on{background:var(--bee);color:var(--ink);border-color:var(--bee)}
+.dk .seg{background:#16181D;border-color:#2A2E36}
+.dk .seg .on{background:var(--bee);color:var(--ink)}
+.dk .kpis{background:var(--card)}
+.dk .search{background:#16181D;border-color:#2A2E36}
+.cmd{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
+.cmd h1{font-size:28px}
+.b-main{grid-template-columns:minmax(0,2fr) minmax(0,1fr)}
+.tile-num{font:700 40px/1 var(--font);letter-spacing:-.03em;font-variant-numeric:tabular-nums}
+.flag{width:8px;height:8px;border-radius:50%;background:var(--flare);display:inline-block;margin-right:8px;vertical-align:middle}
+
+/* Concept C · focus split */
+.split{grid-template-columns:minmax(0,7fr) minmax(0,5fr);align-items:start}
+.q{display:grid;gap:12px}
+.qi{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px 18px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px 16px;align-items:center}
+.qi .meta{color:var(--mut);font-size:12.5px}
+.qi .bar{height:6px;border-radius:99px;background:var(--track);overflow:hidden;margin-top:8px}
+.qi .bar i{display:block;height:100%;border-radius:99px}
+.avatar{width:28px;height:28px;border-radius:50%;display:inline-grid;place-items:center;background:var(--ink);color:var(--bee);font:700 11px var(--font);flex:none}
+.pipe{display:grid;grid-template-columns:repeat(4,1fr);gap:0}
+.stage{position:relative;padding:14px 18px;border-right:1px solid var(--line)}
+.stage:last-child{border-right:0}
+.stage .n{font:700 26px var(--font);letter-spacing:-.02em;font-variant-numeric:tabular-nums}
+.stage .bar{height:6px;border-radius:99px;background:var(--track);margin-top:10px;overflow:hidden}
+.stage .bar i{display:block;height:100%;background:var(--ink);border-radius:99px}
+
+/* Concept D · bento */
+.bento{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
+.tile{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:18px;min-width:0;display:flex;flex-direction:column}
+.tile .lab{display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--mut);font-weight:500}
+.tile .big{font:700 40px/1 var(--font);letter-spacing:-.03em;margin-top:14px;font-variant-numeric:tabular-nums}
+.span2{grid-column:span 2}
+.span3{grid-column:span 3}
+.span4{grid-column:span 4}
+.tall{grid-row:span 2}
+.t-bee{background:var(--bee);border-color:var(--bee);color:var(--ink)}
+.t-bee .lab,.t-bee small{color:rgba(8,9,11,.7)}
+.t-ink{background:var(--ink);border-color:var(--ink);color:#fff}
+.t-ink .lab{color:#A3A9B3}
+.t-ink .gv{fill:#fff}
+.tile .foot{margin-top:auto;padding-top:12px}
+
+/* System page */
+.sys-sec{margin-top:28px}
+.sys-sec>h2{margin-bottom:12px;font-size:17px}
+.sw-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
+.type-row{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid var(--line2)}
+.type-row:last-child{border-bottom:0}
+.logo-tile{border-radius:16px;padding:28px;display:grid;place-items:center;min-height:150px;border:1px solid var(--line)}
+.logo-tile img{width:200px;height:auto;display:block}
+.rules li{margin:6px 0}
+
+/* Icons page */
+.ic-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
+.ic-tile{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;display:flex;flex-direction:column;gap:10px}
+.ic-tile .ic{color:var(--ink)}
+.ic-tile b{font-size:13px;font-weight:600}
+.ic-tile span{font-size:12px;color:var(--mut)}
+.ic-row{display:flex;align-items:center;gap:18px;flex-wrap:wrap}
+.ic-row .ic{color:var(--ink)}
+
+@media (max-width: 1000px){
+  .g3,.g2,.split,.b-main{grid-template-columns:1fr}
+  .kpis{grid-template-columns:1fr 1fr}
+  .kpi:nth-child(2){border-right:0}
+  .kpi:nth-child(-n+2){border-bottom:1px solid var(--line)}
+  .bento{grid-template-columns:1fr 1fr}
+  .span3,.span4{grid-column:span 2}
+  .ic-grid{grid-template-columns:repeat(3,minmax(0,1fr))}
+  .sw-grid{grid-template-columns:1fr 1fr}
+  .pipe{grid-template-columns:1fr 1fr}
+  .search{min-width:0;width:100%}
+}
