+.idbox h4 small{letter-spacing:0;text-transform:none;font-weight:600;font-size:11.5px}
+.idcard{margin-top:12px;display:inline-block;border:1px solid var(--line);border-radius:14px;padding:10px 14px;font-size:12.5px;color:var(--mut);line-height:1.8}
+.idcard b{color:var(--text)}
+.kform-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:18px;align-items:start}
+.kform-layout>.fwrap{min-width:0}
+.kform-side{position:sticky;top:76px;display:grid;gap:12px}
+.kside-card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px 18px}
+.kside-card h3{margin:0 0 10px;font-size:14px;font-weight:700;color:var(--text)}
+.kside-defs{display:grid;grid-template-columns:1fr auto;gap:8px 12px;margin:0;font-size:13px}
+.kside-defs dt{color:var(--mut)}
+.kside-defs dd{margin:0;font-family:var(--mono);font-weight:600;color:var(--text);text-align:right}
+.kside-note{font-size:12.5px;color:var(--mut);background:var(--paper)}
+.kside-steps{margin:0;padding-left:20px;display:grid;gap:10px;font-size:13px;line-height:1.5;color:#34333A}
+.kside-steps b{color:var(--text)}
+@media (max-width:900px){.kform-layout{grid-template-columns:minmax(0,1fr)}.kform-side{position:static}}
+.submit{background:var(--bee);color:var(--ink);border:0;border-radius:14px;padding:12px 18px;font-weight:700;font-size:14px;cursor:pointer;min-height:44px}
+.submit:disabled{opacity:.5;cursor:not-allowed}
+.admin-split{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:18px;align-items:start}
+.admin-split>div{min-width:0}
+.admin-add{position:sticky;top:76px;padding:18px 20px}
+@media (max-width:900px){.admin-split{grid-template-columns:minmax(0,1fr)}.admin-add{position:static}}
+.admtabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
+.admtabs button{background:var(--card);border:1px solid var(--line);color:#34333A;padding:9px 14px;border-radius:12px;font:600 13px var(--font);cursor:pointer;min-height:44px}
+.admtabs button.on{background:var(--ink);color:#fff;border-color:transparent}
+.kpi-strip{margin-bottom:16px}
+.note2{font-size:12px;color:var(--mut);margin:14px 2px 0}
+.tbl-wrap{overflow:auto;border-radius:14px}
+.tbl{width:100%;border-collapse:collapse;font-size:12.5px}
+.tbl th{text-align:left;font-size:10.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--mut);font-weight:700;padding:10px;border-bottom:1px solid var(--line);white-space:nowrap}
+.tbl td{padding:10px;border-bottom:1px solid var(--line2);vertical-align:middle}
+.pagebar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-top:12px;font-size:12.5px;color:var(--mut)}
+.pagebar .btn:disabled{opacity:.45;cursor:not-allowed}
+.hub-resp{display:grid;gap:3px;min-width:200px;max-width:280px}
+.updated{font-size:12px;color:var(--mut)}
+.install-box{display:grid;gap:6px;margin-top:4px}
+.install-box .btn{justify-self:stretch;text-align:center}
+.install-help{margin:0;font-size:12px;line-height:1.4;color:var(--mut)}
