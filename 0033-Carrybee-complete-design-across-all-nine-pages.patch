+/* ---- App chrome (v4): logo left with name beside it, icon buttons, role inside Sign out, tabs centred under the bar ---- */
+.app-top{position:sticky;top:0;z-index:20;background:#fff;border-bottom:1px solid var(--line)}
+.app-bar{max-width:1280px;margin:0 auto;padding:12px 24px;display:flex;align-items:center;gap:16px}
