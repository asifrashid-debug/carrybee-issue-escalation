+.ks{font-size:12.5px;color:var(--mut);margin-top:8px;line-height:1.45}
+.ring{position:relative;width:110px;height:110px;margin:auto}
+.ring span{position:absolute;inset:0;display:grid;place-items:center;font-weight:700;font-size:21px;font-variant-numeric:tabular-nums}
+.ring span small{font-size:12px;margin-left:2px}
+.alog{display:flex;flex-direction:column;gap:10px}
+.tl-main{min-width:0}
+.y{color:#7A5B00}
+.box-ok{border-color:transparent;background:#CFF8E9;color:#0A6A49}
+.btn-primary{background:var(--bee);border:1px solid var(--bee);color:var(--ink);font-weight:700}
+.btn-primary:hover{filter:brightness(.97)}
+.chanpill{display:inline-block;background:var(--bee);color:#141414;font-size:11px;font-weight:700;letter-spacing:.06em;padding:4px 10px;border-radius:999px}
+.count{float:right;font-size:12px;color:var(--mut);font-weight:600}
+.err{margin:0 0 14px;border:1px solid rgba(255,84,112,.5);background:#FFE4E9;color:#8C1A2C;border-radius:12px;padding:10px 12px;font-size:13px}
+.fbody{padding:20px 0}
+.fwrap{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:20px;min-width:0}
+.hint{font-size:12px;color:var(--mut);margin-top:5px}
+.idbox{border:1px dashed var(--line);border-radius:16px;padding:14px;margin-top:4px}
