+.combo .inp:focus{outline:2px solid var(--bee);outline-offset:1px}
+.combo-hint,.combo-empty{color:var(--mut)}
+.combo-hint{font-size:11.5px;white-space:nowrap}
+.combo-empty{padding:8px 10px;font-size:12.5px;list-style:none}
+.combo-list{position:absolute;left:0;right:0;top:100%;margin:4px 0 0;padding:6px;list-style:none;max-height:260px;overflow:auto;z-index:50;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 18px 40px -20px rgba(0,0,0,.25)}
+.combo-list li{padding:9px 10px;border-radius:8px;cursor:pointer;font-size:13.5px}
+.combo-list li.active,.combo-list li:hover{background:#FFF3C2}
+.copy-btn{display:inline-flex;align-items:center;margin-left:6px;padding:1px 7px;border:1px solid var(--line);border-radius:6px;background:transparent;color:var(--mut);font:600 11px/1.6 var(--font);cursor:pointer}
+.copy-btn:hover,.copy-btn:focus-visible{color:var(--text);border-color:var(--mut);outline:none}
+.bell-btn{position:relative}
+.bell-badge{position:absolute;top:-5px;right:-5px;min-width:19px;height:19px;padding:0 5px;border-radius:999px;background:#FF5470;color:#fff;font-size:10.5px;font-weight:700;display:grid;place-items:center;line-height:1}
+.bell-panel{position:absolute;right:0;top:52px;width:min(380px,92vw);max-height:70vh;overflow:auto;z-index:40;border-radius:16px;border:1px solid var(--line);background:var(--card);box-shadow:0 30px 60px -20px rgba(0,0,0,.3);padding:12px}
+.bell-panel ul{list-style:none;margin:0;padding:0;display:grid;gap:4px}
+.bell-head{display:flex;justify-content:space-between;align-items:center;padding:4px 6px 10px}
+.bell-title{font-weight:600;font-size:13px}
+.bell-link{background:none;border:0;color:var(--azure-ink);font-weight:600;font-size:12px;cursor:pointer}
+.bell-body{font-size:12.5px;color:var(--mut)}
+.bell-time{font-size:11px;color:var(--mut)}
+.bell-empty{padding:14px 6px;color:var(--mut);font-size:13px}
+.skeleton{padding:24px;text-align:center;color:var(--mut)}
+.lg-card{max-width:440px;margin:0 auto;background:var(--card);border:1px solid var(--line);border-top:3px solid var(--bee);border-radius:18px;padding:28px}
+.lg-logo{margin-bottom:16px}
+.lg-logo img{height:36px;width:auto}
+.lg-kicker{margin-bottom:6px}
+.lg-title{margin:0 0 6px;font-size:26px;font-weight:700;letter-spacing:-.03em;line-height:1.15}
+.lg-card .meta{margin:0 0 18px;font-size:13px;line-height:1.5;color:var(--mut)}
+.lg-form{display:grid;gap:14px}
+.lg-seg{display:flex;width:100%;margin-bottom:16px}
+.lg-seg button{flex:1 1 0;min-height:44px;font-size:13px}
+.lg-submit{width:100%;min-height:46px;font-size:15px;margin-top:4px}
+.login-wrap{min-height:70vh;display:grid;place-items:center;padding:24px 0}
+.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
+
+/* ===== Form controls (KAM / MX form, Admin add-hub) ===== */
+.fctl{display:flex;align-items:center;min-height:44px;border:1px solid var(--line);border-radius:12px;background:var(--card);padding:0 12px;width:100%;min-width:0}
+.fctl:focus-within{outline:2px solid var(--bee);outline-offset:1px}
+.fctl input,.fctl textarea{flex:1;min-width:0;width:100%;border:0;outline:0;background:transparent;font:inherit;font-size:14px;color:var(--text);min-height:42px}
+.fctl textarea{min-height:96px;padding:10px 0;resize:vertical;line-height:1.5}
+.fctl.lk{background:var(--paper);color:var(--mut)}
+.fctl.lk input{color:var(--mut);cursor:default}
+.fctl select{border:0;outline:0}
+.fctl input::placeholder,.fctl textarea::placeholder{color:#9A9EA8}
+.fgrid .full{grid-column:1/-1}
+.fgrid>div{min-width:0}
+.box-warn{background:#FFF3C2;border-color:transparent;color:#5C4300}
+
+.bell{position:relative;display:inline-flex}
diff --git a/app/cw.css b/app/cw.css
new file mode 100644
