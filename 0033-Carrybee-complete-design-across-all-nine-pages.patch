+/* Live-app classes the demo does not define. Colours use the demo tokens; AA contrast on white and paper. */
+.sla-ok{color:#0A7A56}
+.sla-warn{color:#8A5300}
+.sla-bad{color:#B42339;font-weight:600}
+.box{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:12px 14px;font-size:13px;color:var(--ink2)}
+.box-bad{background:#FFE4E8;border-color:transparent;color:#8C1A2C}
+.box-warn{background:#FFF3C2;border-color:transparent;color:#5C4300}
+.bulk-bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:10px 14px;margin-bottom:12px}
+.bulk-bar .muted{margin-left:auto}
+.empty{padding:20px;text-align:center;color:var(--mut);font-size:13px}
+.flabel{display:block;font-size:12px;font-weight:600;color:var(--mut);margin-bottom:6px}
+.fctl select{width:100%;height:40px;border:1px solid var(--line);border-radius:10px;background:#fff;padding:0 10px;font:inherit;color:var(--text)}
+.grid.g4{grid-template-columns:repeat(4,minmax(0,1fr))}
+@media (max-width:1000px){.grid.g4{grid-template-columns:1fr 1fr}}
+@media (max-width:640px){.grid.g4{grid-template-columns:1fr}}
+.btn.bee{background:var(--bee);border-color:var(--bee);color:var(--ink)}
+.btn.sm{height:30px;font-size:12px;padding:0 10px}
+.btn:disabled{opacity:.45;cursor:not-allowed}
+.search input::placeholder{color:var(--mut)}
+
+/* ---- Issue drawer (components/IssueDrawer.js) in the demo's drawer style: same logic, demo look ---- */
+.scrim{position:fixed;inset:0;z-index:60;background:rgba(23,23,28,.2);display:none}
+.scrim.on{display:block}
+.drawer{position:fixed;top:0;right:0;bottom:0;z-index:61;width:540px;max-width:100%;background:var(--card);border-left:1px solid var(--line);box-shadow:-24px 0 48px -32px rgba(23,23,28,.35);display:none;flex-direction:column;color:var(--text)}
+.drawer.on{display:flex}
+.dh{padding:18px 22px 0;border-bottom:1px solid var(--line)}
+.dtop{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
+.idc{font:600 12px var(--mono);background:var(--paper);border:1px solid var(--line);padding:4px 8px;border-radius:7px}
+.xb{margin-left:auto;width:36px;height:36px;border-radius:10px;border:0;background:transparent;color:var(--ink2);font-size:22px;line-height:1;cursor:pointer}
+.xb:hover{background:var(--paper)}
+.dtitle{margin:12px 0 2px;font-size:20px;letter-spacing:-.015em}
+.dsub{color:var(--mut);font-size:13px;margin:0 0 14px}
+.dsub b{color:var(--ink2);font-weight:600}
+.stats3{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-bottom:14px}
+.stats3>div{padding:12px 14px;border-right:1px solid var(--line);min-width:0}
+.stats3>div:last-child{border-right:0}
+.stats3 small{display:block;font-size:11.5px;color:var(--mut);font-weight:600}
+.stats3 b{display:block;font-size:20px;letter-spacing:-.02em;margin-top:2px;font-variant-numeric:tabular-nums}
+.stats3 b.bad{color:#B42339}
+.stats3 b.good{color:#0A7A56}
+.nextstep{background:var(--paper);border-radius:12px;padding:12px 14px 12px 18px;margin-bottom:14px;position:relative;overflow:hidden}
+.nextstep::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--bee)}
+.nextstep.bad::before{background:#B42339}
+.nextstep small{font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:var(--ink2);font-weight:700}
+.nextstep p{margin:3px 0 0;font-size:13.5px;color:var(--ink2)}
+.dtabs{display:flex;gap:4px;margin:0 -22px;padding:0 22px}
+.dtabs button{position:relative;height:42px;padding:0 12px;border:0;background:transparent;font:600 13.5px var(--font);color:var(--mut);cursor:pointer}
+.dtabs button.on{color:var(--ink)}
+.dtabs button.on::after{content:"";position:absolute;left:10px;right:10px;bottom:-1px;height:3px;background:var(--ink);border-radius:3px 3px 0 0}
+.dbody{flex:1;overflow:auto;padding:18px 22px 28px}
+.kvs{display:grid;grid-template-columns:1fr 1fr;gap:0 18px;margin-bottom:18px}
+.kvs>div{padding:9px 0;border-bottom:1px solid #EEECE6;min-width:0}
+.kvs b{display:block;font-size:11.5px;color:var(--mut);font-weight:600}
+.kvs span{font-size:13.5px}
+.sec2 h4{font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--mut);font-weight:700;margin:20px 0 8px}
+.tl-h{font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--mut);font-weight:700;margin:20px 0 8px}
+.tl-list{list-style:none;margin:0;padding:0;position:relative}
+.tl-list::before{content:"";position:absolute;left:7px;top:10px;bottom:10px;width:2px;background:var(--line)}
+.tl{position:relative;padding:0 0 18px 30px}
+.tl:last-child{padding-bottom:0}
+.tl-dot{position:absolute;left:0;top:3px;width:16px;height:16px;border-radius:50%;background:#fff;border:2px solid #C9C7BE;box-sizing:border-box}
+.tl.done .tl-dot{background:var(--ink);border-color:var(--ink)}
+.tl.late .tl-dot{background:#B42339;border-color:#B42339}
+.tl.due .tl-dot{border-color:var(--ink)}
+.tl.wait .tl-dot,.tl.locked .tl-dot,.tl.hidden .tl-dot{background:var(--paper);border-color:var(--line)}
+.tl-top{display:flex;justify-content:space-between;gap:10px;align-items:baseline;flex-wrap:wrap}
+.tl-top b{font-size:14px;font-weight:700}
+.tl-state{font-size:12px;font-weight:600;color:var(--mut)}
+.tl.done .tl-state{color:var(--ink2)}
+.tl.late .tl-state{color:#B42339}
+.tl.due .tl-state{color:var(--ink)}
+.tl-meta{font-size:13px;color:var(--mut);margin-top:3px}
+.tl-body{font-size:13px;color:var(--ink2);margin:4px 0 0}
+.tl-act{margin-top:10px}
+.audit{list-style:none;margin:8px 0 0;padding:0;font-size:13px}
+.audit li{padding:6px 0;border-bottom:1px solid #EEECE6}
+.entry{padding:12px 0;border-bottom:1px solid #EEECE6}
+.entry .t{display:flex;justify-content:space-between;gap:10px;font-size:12.5px;color:var(--mut)}
+.entry .evt{font-weight:700;color:var(--ink)}
+.linkbtn{background:none;border:0;padding:0;color:#0A7A56;font:inherit;font-weight:700;cursor:pointer}
+.inp{width:100%;font:inherit;font-size:13px;border:1px solid var(--line);border-radius:10px;padding:9px 11px;background:#fff;color:var(--text)}
+.field.full,.full{grid-column:1/-1}
+.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
+.pillc{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 9px;border-radius:999px;font:600 11.5px var(--font);white-space:nowrap}
+.p-br{background:#B42339;color:#fff}
+.p-risk{background:#FFF3C2;color:#7A5B00}
+.p-open{background:#EAF3FE;color:#1F6FD1}
+.p-B{background:#FFF3C2;color:#7A5B00}
+.zc{display:inline-flex;align-items:center;height:22px;padding:0 9px;border-radius:999px;background:var(--paper);border:1px solid var(--line);font:600 11.5px var(--font)}
+@media (max-width:640px){
+  .drawer{top:auto;height:92vh;width:100%;border-left:0;border-radius:20px 20px 0 0}
+  .kvs{grid-template-columns:1fr}
+}
