-
-export function Panel({ title, note, children, className = '', style }) {
-  return (
-    <section className={`glass panel ${className}`} style={style}>
-      {title && <div className="ph"><h3>{title}</h3>{note && <small>{note}</small>}</div>}
-      {children}
-    </section>
-  );
