+.signout{height:40px;display:inline-flex;align-items:center;gap:10px;padding:0 14px 0 12px;border-radius:12px;border:1px solid var(--line);background:#fff;font:inherit;color:var(--text);cursor:default}
+.signout svg{color:var(--mut)}
