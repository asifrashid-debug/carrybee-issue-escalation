+
+/* Admin: hub table beside the add-hub card (demo layout). Stacks below 1100px. */
+.dm .admin-split { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 18px; align-items: start; }
+.dm .admin-split > div { min-width: 0; }
+.dm .admin-add { position: sticky; top: calc(var(--hdr) + 16px); padding: 18px 20px; }
+@media (max-width: 1100px) {
+  .dm .admin-split { grid-template-columns: minmax(0, 1fr); }
+  .dm .admin-add { position: static; }
