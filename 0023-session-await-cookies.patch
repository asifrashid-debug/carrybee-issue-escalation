From 895000569a0ee8ef09f05d819c3d217ddf780d8c Mon Sep 17 00:00:00 2001
From: ahmed asif rashid <asif.rashid@carrybee.com>
Date: Mon, 16 Nov 2026 07:24:23 +0000
Subject: [PATCH] Session: await cookies() (Next 15+ returns a Promise)

Without await, store.getAll is undefined and the Supabase auth read throws
'store.getAll is not a function' for requests that carry the sign-in cookie.
Signed-in users then get failed or empty API responses (Tracker shows
'Could not load issues: Unexpected end of JSON input').
---
 lib/session.js | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/session.js b/lib/session.js
index db987d9..5b58f0a 100644
--- a/lib/session.js
+++ b/lib/session.js
@@ -9,7 +9,7 @@ const anon = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;
 // Server-side session from the Supabase auth cookie. The signed-in email is the only identity the API trusts.
 // Role, teams, zone and region come from users_roles (active rows only). Returns null when not signed in or not listed.
 export async function getSessionUser() {
-  const store = cookies();
+  const store = await cookies(); // Next 15+: cookies() returns a Promise; awaiting it is required
   const sb = createServerClient(url, anon, {
     cookies: {
       getAll: () => store.getAll(),
-- 
2.47.3

