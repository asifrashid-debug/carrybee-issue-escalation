+// Breach count as it stood at time `at`, using the same rules as the live breach count.
+// Open at that time: not closed by then. An issue closed since is treated as closed at its last update (updated_at),
+// so it still counts as open before that update. Commented by then: first comment on or before that time.
+export function breachesAt(rows, catIndex, at) {
+  const t = new Date(at).getTime();
+  let n = 0;
+  for (const e of rows) {
+    const raised = new Date(e.submitted_at).getTime();
+    if (!(raised <= t)) continue;
+    const updated = e.updated_at ? new Date(e.updated_at).getTime() : raised;
+    const issueOpen = e.issue_status !== 'Closed' || updated > t;
+    const resolvedByT = e.ops_issue_status === 'Resolved' && updated <= t;
+    const commented = !!e.issue_response_datetime && new Date(e.issue_response_datetime).getTime() <= t;
+    const commentBreach = issueOpen && !commented && (t - raised) / 3600000 > SLA.responseHours;
+    const dueMs = raised + resolutionSla(catIndex, e).hours * 3600000;
+    const resBreach = issueOpen && !resolvedByT && t > dueMs;
+    if (commentBreach || resBreach) n++;
+  }
+  return n;
+}
+
+// Past SLA trend: breaches now, a week ago (delta), and one point per day for the last `days` days (the last point is now).
+export function breachTrend(rows, catIndex, now, days = 14) {
+  const nowMs = new Date(now).getTime();
+  const DAY = 24 * 3600000;
+  const nowCount = breachesAt(rows, catIndex, nowMs);
+  const lastWeek = breachesAt(rows, catIndex, nowMs - 7 * DAY);
+  const daily = [];
+  for (let k = days - 1; k >= 0; k--) daily.push(breachesAt(rows, catIndex, nowMs - k * DAY));
+  return { now: nowCount, lastWeek, delta: nowCount - lastWeek, daily };
+}
+
 export function computeAnalytics({ escalations = [], users = [], hubs = [], categories = [], now = new Date(), days = 14, sla = SLA }) {
   const rows = escalations.filter((e) => !e.is_archived);
   const nowMs = new Date(now).getTime();
@@ -246,6 +278,7 @@ export function computeAnalytics({ escalations = [], users = [], hubs = [], cate
