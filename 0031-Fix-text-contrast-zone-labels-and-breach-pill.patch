From ce7bdbe53bccb0cdff123b2ad481625f119a958e Mon Sep 17 00:00:00 2001
From: ahmed asif rashid <asif.rashid@carrybee.com>
Date: Mon, 16 Nov 2026 13:33:56 +0000
Subject: [PATCH] Fix text contrast: zone labels use dark text with coloured
 dot; breach pill uses AA-compliant red

---
 app/analytics/page.js | 2 +-
 app/dashboard/page.js | 2 +-
 app/hubs/page.js      | 2 +-
 app/trk-demo.css      | 2 +-
 4 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/app/analytics/page.js b/app/analytics/page.js
index 1c3e32b..a35df9b 100644
--- a/app/analytics/page.js
+++ b/app/analytics/page.js
@@ -126,7 +126,7 @@ export default function Analytics() {
             {data.zones.map((z) => (
               <div key={z.zone} className="lrow" style={{ display: 'block' }}>
                 <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
-                  <b style={{ color: ZONE_COLOR[z.zone] }}>● {z.zone}</b>
+                  <b><span aria-hidden="true" style={{ color: ZONE_COLOR[z.zone] }}>● </span>{z.zone}</b>
                   <b className={z.responseSlaPct == null ? '' : z.responseSlaPct >= 90 ? 'good' : z.responseSlaPct >= 75 ? 'warn' : 'bad'}>{fmtPct(z.responseSlaPct)} SLA</b>
                 </div>
                 <Bar pct={z.responseSlaPct ?? 0} color={ZONE_COLOR[z.zone]} />
diff --git a/app/dashboard/page.js b/app/dashboard/page.js
index 4964bce..49125d9 100644
--- a/app/dashboard/page.js
+++ b/app/dashboard/page.js
@@ -82,7 +82,7 @@ export default function Dashboard() {
           <div className="lst" style={{ marginTop: 10 }}>
             {data.zones.map((z) => (
               <div key={z.zone} style={{ display: 'flex', justifyContent: 'space-between', fontSize: 12.5, gap: 8, flexWrap: 'wrap' }}>
-                <b style={{ color: ZONE_COLOR[z.zone] || '#FFCC00' }}>● {z.zone} Zone</b>
+                <b><span aria-hidden="true" style={{ color: ZONE_COLOR[z.zone] || '#FFCC00' }}>● </span>{z.zone} Zone</b>
                 <span>{fmtN(z.open)} open · {fmtN(z.resolved)} resolved · <span className={z.breaches ? 'bad' : ''}>{fmtN(z.breaches)} breached</span></span>
               </div>
             ))}
diff --git a/app/hubs/page.js b/app/hubs/page.js
index 4e3d770..35d5463 100644
--- a/app/hubs/page.js
+++ b/app/hubs/page.js
@@ -163,7 +163,7 @@ export default function HubPerformance() {
             <div key={z} className="card" style={{ display: 'flex', gap: 14, alignItems: 'center' }}>
               <div style={{ width: 130, flex: '0 0 130px' }}><Gauge value={score ?? 0} color={ZONE_COLOR[z]} center={score == null ? '—' : `${score}%`} sub="score" w={130} /></div>
               <div>
-                <b style={{ fontSize: 15, color: ZONE_COLOR[z] }}>● {z} Zone</b>
+                <b style={{ fontSize: 15 }}><span aria-hidden="true" style={{ color: ZONE_COLOR[z] }}>● </span>{z} Zone</b>
                 <div className="ks">{zh.length} hubs · {fmtN(open)} open · {fmtN(br)} breached</div>
                 <div style={{ display: 'flex', gap: 6, marginTop: 8, flexWrap: 'wrap' }}>
                   {Object.entries(grades).filter(([, n]) => n > 0).map(([g, n]) => <span key={g} className={`pillc p-${g}`}>{g} × {n}</span>)}
diff --git a/app/trk-demo.css b/app/trk-demo.css
index 22cd21b..2e0e2c3 100644
--- a/app/trk-demo.css
+++ b/app/trk-demo.css
@@ -36,7 +36,7 @@
 .trk-demo .p-urg {background:#FFE4E9;color:var(--flare-ink)}
 .trk-demo .p-crit {background:#FFF3C2;color:#7A5B00}
 .trk-demo .p-reg {background:#E3FBF3;color:var(--mint-ink)}
-.trk-demo .p-breach {background:var(--flare);color:#fff}
+.trk-demo .p-breach {background:#B42339;color:#fff}
 .trk-demo .p-ok {background:#E3FBF3;color:var(--mint-ink)}
 .trk-demo .p-wait {background:#EAF3FE;color:var(--azure-ink)}
 .trk-demo .p-res {background:#F0EEE8;color:var(--mut)}
-- 
2.47.3

