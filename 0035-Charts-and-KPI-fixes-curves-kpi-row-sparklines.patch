+/* Five KPI cards (Dashboard, Team): one row on wide screens, same breakpoints as the four-card strip */
+.kpis.k5{grid-template-columns:repeat(5,minmax(0,1fr))}
+@media (max-width: 1000px){
+  .kpis.k5{grid-template-columns:1fr 1fr}
+  .kpis.k5 .kpi:nth-child(2){border-right:0}
