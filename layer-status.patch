diff --git a/lib/layerStatus.js b/lib/layerStatus.js
new file mode 100644
index 0000000..bb57b8b
--- /dev/null
+++ b/lib/layerStatus.js
@@ -0,0 +1,32 @@
+// Layer status (sheet column AI). Pure, no imports, so it can be tested without the Google or Supabase clients.
+// Mirrors the drawer rule in components/IssueDrawer.js: a layer is overdue only when it is empty, every earlier
+// layer is empty, and the issue has been open longer than the layer's hours (Layer 1 2h, Layer 2 4h, Layer 3 6h).
+// The sheet cell is a live formula, so it follows the clock and the hub's Layer 1-3 cells without waiting for a sync.
+const H_MS = 3600e3;
+
+export const LAYER_STATUS_COL = 'AI';
+export const LAYER_HOURS = [2, 4, 6];
+export const LAYER_STATUS_VALUES = ['Layer 1 overdue', 'Layer 2 overdue', 'Layer 3 overdue', 'No layer overdue'];
+
+// Formula for one row. Q, R, S are Layer 1-3 responses; B is the Timestamp (raised).
+export function layerStatusFormula(rowNum) {
+  const r = rowNum;
+  const empty = (c) => `LEN(${c}${r})=0`;
+  const [h1, h2, h3] = LAYER_HOURS;
+  return `=IF(B${r}="","",IF(AND(${empty('Q')},NOW()>B${r}+${h1}/24),"Layer 1 overdue",` +
+    `IF(AND(${empty('Q')},${empty('R')},NOW()>B${r}+${h2}/24),"Layer 2 overdue",` +
+    `IF(AND(${empty('Q')},${empty('R')},${empty('S')},NOW()>B${r}+${h3}/24),"Layer 3 overdue","No layer overdue"))))`;
+}
+
+// Pure mirror of the formula, used by the tests. Returns the same text the sheet shows (to the minute).
+export function layerStatus(e, nowMs = Date.now()) {
+  if (!e.submitted_at) return '';
+  const raised = new Date(e.submitted_at).getTime();
+  const filled = [e.layer1_response, e.layer2_response, e.layer3_response].map((v) => String(v ?? '').trim().length > 0);
+  for (let i = 0; i < 3; i++) {
+    const ownEmpty = !filled[i];
+    const earlierEmpty = filled.slice(0, i).every((f) => !f);
+    if (ownEmpty && earlierEmpty && nowMs > raised + LAYER_HOURS[i] * H_MS) return `Layer ${i + 1} overdue`;
+  }
+  return 'No layer overdue';
+}
