+// Writes only the Layer Status cell (AI) for the given sheet rows, in batches. Never touches any other column.
+export async function writeLayerStatusCells(sid, rowNums) {
+  const sheets = getSheetsClient();
+  const nums = [...new Set(rowNums)];
+  for (let i = 0; i < nums.length; i += 200) {
+    const chunk = nums.slice(i, i + 200);
+    await sheets.spreadsheets.values.batchUpdate({
+      spreadsheetId: sid,
+      requestBody: {
+        valueInputOption: 'USER_ENTERED',
+        data: chunk.map((n) => ({ range: `Active!${LAYER_STATUS_COL}${n}`, values: [[layerStatusFormula(n)]] })),
+      },
+    });
+  }
+  return nums.length;
+}
