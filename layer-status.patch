diff --git a/tests/layerStatus.test.mjs b/tests/layerStatus.test.mjs
new file mode 100644
index 0000000..14428b1
--- /dev/null
+++ b/tests/layerStatus.test.mjs
@@ -0,0 +1,43 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { layerStatus, layerStatusFormula, LAYER_STATUS_VALUES } from '../lib/layerStatus.js';
+
+const raised = '2026-11-14T06:00:00Z'; // 12:00 Dhaka
+const at = (hours) => new Date(raised).getTime() + hours * 3600e3;
+
+test('Layer 1 is overdue after 2h with no response', () => {
+  assert.equal(layerStatus({ submitted_at: raised }, at(2.1)), 'Layer 1 overdue');
+  assert.equal(layerStatus({ submitted_at: raised }, at(1.9)), 'No layer overdue');
+});
+
+test('once Layer 1 is answered, Layer 2 is not flagged (drawer rule)', () => {
+  const e = { submitted_at: raised, layer1_response: 'Rider assigned' };
+  // Layer 1 filled: Layer 2 is only overdue when Layer 1 is also empty (drawer rule), so this stays clear.
+  assert.equal(layerStatus(e, at(5)), 'No layer overdue');
+});
+
+test('Layer 2 and 3 are overdue only while every earlier layer is empty', () => {
+  assert.equal(layerStatus({ submitted_at: raised }, at(4.1)), 'Layer 1 overdue'); // first empty layer wins
+  assert.equal(layerStatus({ submitted_at: raised, layer1_response: 'x' }, at(7)), 'No layer overdue');
+  assert.equal(layerStatus({ submitted_at: raised, layer1_response: 'x', layer2_response: 'y' }, at(9)), 'No layer overdue');
+});
+
+test('whitespace-only responses count as empty', () => {
+  assert.equal(layerStatus({ submitted_at: raised, layer1_response: '   ' }, at(2.5)), 'Layer 1 overdue');
+});
+
+test('no timestamp gives a blank status, as the formula does', () => {
+  assert.equal(layerStatus({}, at(10)), '');
+});
+
+test('formula uses the right cells, hours and labels', () => {
+  const f = layerStatusFormula(42);
+  assert.ok(f.startsWith('=IF(B42="","",'));
+  assert.ok(f.includes('NOW()>B42+2/24'));
+  assert.ok(f.includes('NOW()>B42+4/24'));
+  assert.ok(f.includes('NOW()>B42+6/24'));
+  assert.ok(f.includes('LEN(Q42)=0') && f.includes('LEN(R42)=0') && f.includes('LEN(S42)=0'));
+  for (const v of LAYER_STATUS_VALUES) assert.ok(f.includes(`"${v}"`), v);
+  // Balanced brackets, so Sheets will parse it.
+  assert.equal([...f].filter((c) => c === '(').length, [...f].filter((c) => c === ')').length);
+});
