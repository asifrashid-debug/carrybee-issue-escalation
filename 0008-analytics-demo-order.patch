+                  <div style={{ display: 'flex', justifyContent: 'space-between', fontSize: 12.5 }}><span>{c.label}</span><b>{fmtN(c.count)}</b></div>
+                  <Bar pct={pct(c.count, k.total)} color="#F8C800" />
+                </div>
+              ))}
+            </div>
+          )}
+        </div>
+      </div>
 
