diff --git a/app/design-v3.css b/app/design-v3.css
index f721166..ecff6c6 100644
--- a/app/design-v3.css
+++ b/app/design-v3.css
@@ -555,3 +555,22 @@ html, body { -webkit-tap-highlight-color: transparent; }
 @media (max-width: 720px) {
   .dm .trk-side { grid-template-columns: minmax(0, 1fr); }
 }
+
+/* Admin: hub table beside the add-hub card (demo layout). Stacks below 1100px. */
+.dm .admin-split { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 18px; align-items: start; }
+.dm .admin-split > div { min-width: 0; }
+.dm .admin-add { position: sticky; top: calc(var(--hdr) + 16px); padding: 18px 20px; }
+@media (max-width: 1100px) {
+  .dm .admin-split { grid-template-columns: minmax(0, 1fr); }
+  .dm .admin-add { position: static; }
+}
+
+/* Tracker pipeline: five stages in a row; two per row on phones */
+.dm .pipe-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
+.dm .pipe-grid > div { padding: 12px 18px; min-width: 0; }
+.dm .pipe-grid > div + div { border-left: 1px solid var(--line); }
+@media (max-width: 700px) {
+  .dm .pipe-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .dm .pipe-grid > div:nth-child(odd) { border-left: 0; }
+  .dm .pipe-grid > div:nth-child(n+3) { border-top: 1px solid var(--line); }
+}
